
WITH
/* =========================================================
   1. AGING: 0 TO 179 DAYS
   Replaces qry_Escal_Aging_Hedge_0to179
   ========================================================= */
QRY_ESCAL_AGING_HEDGE_0TO179 AS (
    SELECT
        Dept,
        ReasonType,
        COUNT(CASE
            WHEN DiscvAge >= 30 AND DiscvAge < 60
            THEN ISIN
        END) AS "30-59",

        COUNT(CASE
            WHEN DiscvAge >= 60 AND DiscvAge < 90
            THEN ISIN
        END) AS "60-89",

        COUNT(CASE
            WHEN DiscvAge >= 90 AND DiscvAge < 120
            THEN ISIN
        END) AS "90-119",

        COUNT(CASE
            WHEN DiscvAge >= 120 AND DiscvAge < 150
            THEN ISIN
        END) AS "120-149",

        COUNT(CASE
            WHEN DiscvAge >= 150 AND DiscvAge < 180
            THEN ISIN
        END) AS "150-179"

    FROM qry_Escal_Details_HedgeSetup
    WHERE DiscvAge >= 0
      AND DiscvAge < 180
    GROUP BY Dept, ReasonType
),

/* =========================================================
   2. AGING: 180 TO 364 DAYS
   Replaces qry_Escal_Aging_Hedge_180to364
   ========================================================= */
QRY_ESCAL_AGING_HEDGE_180TO364 AS (
    SELECT
        Dept,
        ReasonType,
        COUNT(ISIN) AS "180to364"
    FROM qry_Escal_Details_HedgeSetup
    WHERE DiscvAge >= 180
      AND DiscvAge < 365
    GROUP BY Dept, ReasonType
),

/* =========================================================
   3. AGING: 1 YEAR (365 TO 729 DAYS)
   Replaces qry_Escal_Aging_Hedge_1Yr
   ========================================================= */
QRY_ESCAL_AGING_HEDGE_1YR AS (
    SELECT
        Dept,
        ReasonType,
        COUNT(ISIN) AS "1Yr"
    FROM qry_Escal_Details_HedgeSetup
    WHERE DiscvAge >= 365
      AND DiscvAge < 730
    GROUP BY Dept, ReasonType
),

/* =========================================================
   4. AGING: 2 YEARS (730 TO 1094 DAYS)
   Replaces qry_Escal_Aging_Hedge_2Yr
   ========================================================= */
QRY_ESCAL_AGING_HEDGE_2YR AS (
    SELECT
        Dept,
        ReasonType,
        COUNT(ISIN) AS "2Yr"
    FROM qry_Escal_Details_HedgeSetup
    WHERE DiscvAge >= 730
      AND DiscvAge < 1095
    GROUP BY Dept, ReasonType
),

/* =========================================================
   5. AGING: 3 YEARS AND ABOVE (1095+ DAYS)
   Replaces qry_Escal_Aging_Hedge_3Yr+
   ========================================================= */
QRY_ESCAL_AGING_HEDGE_3YR_PLUS AS (
    SELECT
        Dept,
        ReasonType,
        COUNT(ISIN) AS "3Yr+"
    FROM qry_Escal_Details_HedgeSetup
    WHERE DiscvAge >= 1095
    GROUP BY Dept, ReasonType
)

/* =========================================================
   FINAL MAIN QUERY
   Replaces qry_Escal_Aging_Hedge
   ========================================================= */
SELECT
    A.Dept,
    A.ReasonType,
    A."30-59",
    A."60-89",
    A."90-119",
    A."120-149",
    A."150-179",
    B."180to364" AS "180-364",
    C."1Yr",
    D."2Yr",
    E."3Yr+"

FROM QRY_ESCAL_AGING_HEDGE_0TO179 A

LEFT JOIN QRY_ESCAL_AGING_HEDGE_180TO364 B
    ON A.Dept = B.Dept
   AND A.ReasonType = B.ReasonType

LEFT JOIN QRY_ESCAL_AGING_HEDGE_1YR C
    ON A.Dept = C.Dept
   AND A.ReasonType = C.ReasonType

LEFT JOIN QRY_ESCAL_AGING_HEDGE_2YR D
    ON A.Dept = D.Dept
   AND A.ReasonType = D.ReasonType

LEFT JOIN QRY_ESCAL_AGING_HEDGE_3YR_PLUS E
    ON A.Dept = E.Dept
   AND A.ReasonType = E.ReasonType

ORDER BY
    A.Dept,
    A.ReasonType;
