WITH SRC AS
(
    SELECT
        V.*,
        ROW_NUMBER() OVER
        (
            PARTITION BY LOCAL_ACC_NO,
                         STOCK_CODE
            ORDER BY SYS_ENTRY_DATE,
                     ITEM_ID
        ) RN
    FROM V_MASTERPOSITIONBREAKS V
)

SELECT
    LOCAL_ACC_NO,
    STOCK_CODE,
    AGENT_CODE,

    MAX(STMT_DATE) AS MAXOFSTATEMENT,

    MAX(CASE WHEN LS_TYPE=9030 THEN AMOUNT_6 ELSE 0 END) AS MAXOFBBHAMOUNT,

    MAX(CASE WHEN LS_TYPE<>9030 THEN AMOUNT_6 ELSE 0 END) AS MAXOFNSCCAMOUNT,

    MAX(CASE WHEN RN=1 THEN STRING_27 END) AS FIRSTOFSECID,

    MAX(CASE WHEN RN=1 THEN STRING_28 END) AS FIRSTOFSECNAME,

    MAX(
        CASE
            WHEN RN=1 THEN
                CASE
                    WHEN LENGTH(TRIM(STRING_14))>0
                        THEN TRIM(STRING_14)
                    WHEN SUBSTR(LOCAL_ACC_NO,8,1)='-'
                        THEN SUBSTR(LOCAL_ACC_NO,1,7)
                    ELSE 'OMNIBUS'
                END
        END
    ) AS FIRSTOFBBHACCTNUM,

    MAX(CASE WHEN RN=1 THEN STRING_29 END) AS FIRSTOFBBHACCTNAME,

    MAX(CASE WHEN RN=1 THEN STRING_21 END) AS FIRSTOFBBHEXTACCTNUM,

    MAX(CASE WHEN RN=1 THEN STRING_21 END) AS LASTOFNSCCEXTACCTNUM,

    MAX(AMOUNT_5) AS MAXOFPRICE,

    MAX(CASE WHEN RN=1 THEN STRING_13 END) AS FIRSTOFFREQ

FROM SRC
GROUP BY
    LOCAL_ACC_NO,
    STOCK_CODE,
    AGENT_CODE;
