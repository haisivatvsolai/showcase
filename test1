WITH SRC AS
(
    SELECT
        V.*,
        ROW_NUMBER() OVER (
            PARTITION BY LOCAL_ACC_NO, STOCK_CODE, AGENT_CODE
            ORDER BY ITEM_ID
        ) RN
    FROM V_MASTERPOSITIONBREAKS V
)
SELECT
    LOCAL_ACC_NO,
    STOCK_CODE,
    AGENT_CODE,

    MAX(STMT_DATE) AS MAXOFSTATEMENT,

    MAX(CASE WHEN LS_TYPE = 9030
             THEN AMOUNT_6
             ELSE 0
        END) AS MAXOFBBHAMOUNT,

    MAX(CASE WHEN LS_TYPE = 9030
             THEN 0
             ELSE AMOUNT_6
        END) AS MAXOFNSCCAMOUNT,

    MAX(CASE WHEN RN = 1 THEN STRING_28 END) AS FIRSTOFSECNAME,

    MAX(CASE WHEN RN = 1 THEN STRING_29 END) AS FIRSTOFBBHACCTNAME,

    MAX(CASE WHEN RN = 1 THEN STRING_21 END) AS FIRSTOFBBHEXTACCTNUM,

    MAX(CASE WHEN RN = 1 THEN STRING_13 END) AS FIRSTOFFREQ,

    MAX(AMOUNT_5) AS MAXOFPRICE

FROM SRC
GROUP BY
    LOCAL_ACC_NO,
    STOCK_CODE,
    AGENT_CODE;
