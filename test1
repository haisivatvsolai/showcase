	-- Oracle SQL equivalent of qry_FSDailyStats_View
-- Dynamically handles Monday (Fri-Sun: >= input_date - 3) vs. all other days (yesterday: = input_date - 1)
SELECT 
    TRUNC(i.STMT_DATE) AS STMT_DATE,
    COUNT(i.GIN) AS TotalItems,
    COUNT(CASE WHEN i.LAST_ACTION_OWNER = 'SYSTEM' THEN i.GIN END) AS STP,
    COUNT(CASE WHEN i.FLAG_2 = 0 AND (i.BRAN_CODE = ' ' OR TRIM(i.BRAN_CODE) IS NULL) THEN i.GIN END) AS UnCoded,
    COUNT(CASE WHEN i.FLAG_2 = 0 THEN i.GIN END) AS TotalOpen
FROM 
    TLMADM_ITEM i
    INNER JOIN TLMADM_BANK b 
        ON i.CORR_ACC_NO = b.CORR_ACC_NO
WHERE 
    b.LOCAL_ACC_NO = 'FUNDSETTLE TRANS POS'
    AND i.LS_TYPE IN (9105, 9106, 9129, 9128)
    AND (
        (
            TO_CHAR(TRUNC(:input_date), 'DY', 'NLS_DATE_LANGUAGE=ENGLISH') = 'MON'
            AND TRUNC(i.STMT_DATE) >= TRUNC(:input_date) - 3
            AND TRUNC(i.STMT_DATE) < TRUNC(:input_date)
        )
        OR
        (
            TO_CHAR(TRUNC(:input_date), 'DY', 'NLS_DATE_LANGUAGE=ENGLISH') <> 'MON'
            AND TRUNC(i.STMT_DATE) = TRUNC(:input_date) - 1
        )
    )
GROUP BY 
    TRUNC(i.STMT_DATE)
ORDER BY 
    STMT_DATE DESC;
	
	
